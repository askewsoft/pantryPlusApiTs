# Copy to `.env.prod` for production RDS (gitignored). Never commit real secrets.
# Usage: npm run item-dedupe:generate -- --env prod

APIPORT=3000

DBPORT=3306
DBHOST=your-rds-hostname.region.rds.amazonaws.com
DBUSER=your_db_user
DBPASSWORD=your_db_password
DATABASE=PANTRY_PLUS

DBSSL=true
DBREJECTUNAUTHORIZED=true

# production enables RDS CA at certs/rds-ca.pem (npm run downloadcerts)
NODE_ENV=production
LOG_LEVEL=info
