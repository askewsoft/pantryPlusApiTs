# Copy to `.env` for local development. Never commit real secrets.

# HTTP listen port for the API process
APIPORT=3000

# MySQL
DBPORT=3306
DBHOST=127.0.0.1
DBUSER=your_db_user
DBPASSWORD=your_db_password
DATABASE=PANTRY_PLUS

# SSL to MySQL (use true + certs for RDS; often false for local Docker MySQL)
DBSSL=false
DBREJECTUNAUTHORIZED=false

# Runtime
NODE_ENV=development
LOG_LEVEL=info
